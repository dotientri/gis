pipeline{
    agent any
    environment {
        DOCKERHUB_CREDS = credentials('dockerhub-creds')
        DOCKERHUB_USER = "hiiamgay" // Thay bằng username Docker Hub của bạn
    }
    stages{
        stage('Build and Push Image DockerHub'){
            steps {
                echo "Login DockerHub"
                sh "docker login -u ${DOCKERHUB_CREDS_USR} -p ${DOCKERHUB_CREDS_PSW}"
                
                echo "Build Image Backend and Frontend"
                // Sử dụng biến BUILD_NUMBER của Jenkins để đánh tag tự động (v1, v2, v3...)
                sh "docker build -f qlycv/backend/Dockerfile -t ${DOCKERHUB_USER}/gis-backend:v${BUILD_NUMBER} ./qlycv/backend"
                sh "docker build -f qlycv/frontend/Dockerfile -t ${DOCKERHUB_USER}/gis-frontend:v${BUILD_NUMBER} ./qlycv/frontend"
                
                echo "Push Image to DockerHub"
                sh "docker push ${DOCKERHUB_USER}/gis-backend:v${BUILD_NUMBER}"
                sh "docker push ${DOCKERHUB_USER}/gis-frontend:v${BUILD_NUMBER}"
            }
        }
    }
    post{
        always {
            // Xoá thông tin đăng nhập Docker sau khi chạy xong để bảo mật
            sh "docker logout"
        }
    }
}
